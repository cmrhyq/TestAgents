@startuml er-diagram
!theme plain
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "Microsoft YaHei, SimHei, sans-serif"
skinparam linetype ortho

skinparam entity {
  BackgroundColor #F8F9FA
  BorderColor #495057
}

title TestAgents - Entity Relationship Diagram

entity "space" as space {
  * **id** : Integer <<PK>>
  --
  * name : Text <<UNIQUE>>
  * base_url : Text
  description : Text
  * workspace_path : Text <<相对路径>>
  * status : Integer
  * created_at : Text
  * updated_at : Text
}

entity "environment" as environment {
  * **id** : Integer <<PK>>
  --
  * space_id : Integer <<FK>>
  * name : Text
  * base_url : Text
  description : Text
  variables : Text (JSON)
  * is_default : Integer
  * is_production : Integer <<生产闸门>>
  * status : Integer
  * created_at : Text
  * updated_at : Text
}

entity "endpoint" as endpoint {
  * **id** : Integer <<PK>>
  --
  * space_id : Integer <<FK>>
  * operation_id : Text
  * name : Text
  * path : Text <<UQ(space,path,method)>>
  * method : Text <<UQ(space,path,method)>>
  tags : Text (JSON)
  summary : Text
  description : Text
  params : Text (JSON)
  headers : Text (JSON)
  body : Text (JSON)
  responses : Text (JSON)
  security : Text (JSON)
  content_type : Text
  * deprecated : Integer
  * status : Integer
  * version : Integer
  * created_at : Text
  * updated_at : Text
}

entity "test_run" as test_run {
  * **id** : Integer <<PK>>
  --
  * space_id : Integer <<FK>>
  environment_id : Integer <<FK>>
  name : Text
  * status : Text
  * trigger_type : Text
  input_file : Text
  input_snapshot : Text (JSON)
  config_snapshot : Text (JSON)
  llm_provider : Text
  llm_model : Text
  * total_cases : Integer
  * passed_cases : Integer
  * failed_cases : Integer
  * skipped_cases : Integer
  * error_cases : Integer
  * pass_rate : Float
  started_at : Text
  finished_at : Text
  * total_duration : Float
  error_message : Text
  * created_at : Text
  * updated_at : Text
}

entity "test_case" as test_case {
  * **id** : Integer <<PK>>
  --
  * run_id : Integer <<FK>>
  endpoint_id : Integer <<FK>>
  * case_id : Text
  * case_name : Text
  * url : Text
  * method : Text
  * scenario_type : Text
  * priority : Text
  headers : Text (JSON)
  body : Text (JSON)
  params : Text (JSON)
  cache_rules : Text (JSON)
  assert_rules : Text (JSON)
  expected_result : Text
  description : Text
  remark : Text
  unique_hash : Text
  * generated_by : Text
  * status : Integer
  * created_at : Text
  * updated_at : Text
}

entity "test_result" as test_result {
  * **id** : Integer <<PK>>
  --
  * run_id : Integer <<FK>>
  * test_case_id : Integer <<FK>>
  * case_id : Text
  * case_name : Text
  * status : Text
  request_url : Text
  request_method : Text
  request_headers : Text (JSON)
  request_body : Text
  query_params : Text
  response_status_code : Integer
  response_headers : Text (JSON)
  response_body : Text
  * response_time : Float
  error_message : Text
  * retry_count : Integer
  started_at : Text
  finished_at : Text
  * created_at : Text
}

entity "test_summary" as test_summary {
  * **id** : Integer <<PK>>
  --
  * run_id : Integer <<FK, UNIQUE>>
  * total : Integer
  * passed : Integer
  * failed : Integer
  * skipped : Integer
  * error : Integer
  * pass_rate : Float
  * avg_response_time : Float
  * min_response_time : Float
  * max_response_time : Float
  * p95_response_time : Float
  * total_duration : Float
  failure_reasons : Text (JSON)
  started_at : Text
  finished_at : Text
  * created_at : Text
}

entity "report" as report {
  * **id** : Integer <<PK>>
  --
  * run_id : Integer <<FK>>
  * format : Text
  * file_path : Text
  file_size : Integer
  * generated_at : Text
}

entity "conversation" as conversation {
  * **id** : Integer <<PK>>
  --
  space_id : Integer <<FK>>
  title : Text
  * mode : Text <<agent/ask/plan>>
  skill_names : Text (JSON)
  environment_id : Integer <<FK>>
  * status : Integer
  last_message_at : Text
  * created_at : Text
  * updated_at : Text
}

entity "message" as message {
  * **id** : Integer <<PK>>
  --
  * conversation_id : Integer <<FK>>
  * role : Text
  * content : Text
  * meta : Text (JSON)
  * created_at : Text
}

entity "space_memory" as space_memory {
  * **id** : Integer <<PK>>
  --
  * space_id : Integer <<FK>>
  * title : Text
  * content : Text
  * category : Text <<fact/decision/preference/issue/glossary>>
  * tags : Text (JSON)
  source_conversation_id : Integer <<FK>>
  * status : Integer
  * created_at : Text
  * updated_at : Text
}

entity "knowledge_document" as knowledge_document {
  * **id** : Integer <<PK>>
  --
  * space_id : Integer <<FK>>
  * filename : Text
  * file_path : Text
  * mime : Text
  * size : Integer
  * chunk_count : Integer
  * status : Text <<pending/indexed/failed>>
  * index_mode : Text <<vector/lexical>>
  * error : Text
  * created_at : Text
  * updated_at : Text
}

entity "knowledge_chunk" as knowledge_chunk {
  * **id** : Integer <<PK>>
  --
  * document_id : Integer <<FK>>
  * space_id : Integer <<FK>> <<冗余，加速空间过滤>>
  * seq : Integer
  * content : Text
  chroma_id : Text
  * created_at : Text
}

entity "skill" as skill {
  * **id** : Integer <<PK>>
  --
  * name : Text <<SKILL.md:name>>
  * scope : Text <<builtin/space>>
  space_id : Integer <<逻辑引用，无 FK>>
  * directory : Text
  * description : Text
  * when_to_use : Text
  * version : Text
  * allowed_tools : Text (JSON)
  * enabled : Integer
  * discovered_at : Text
}

entity "llm_log" as llm_log {
  * **id** : Integer <<PK>>
  --
  * model_name : Text <<实际命中模型>>
  * provider : Text
  * request_type : Text
  * prompt_tokens : Integer
  * completion_tokens : Integer
  * total_tokens : Integer
  * duration_ms : Integer
  space_id : Integer <<逻辑引用，无 FK>>
  conversation_id : Integer <<逻辑引用，无 FK>>
  * routing_tier : Text <<SIMPLE/MEDIUM/COMPLEX/REASONING>>
  cost_usd : Float <<NULL=定价未知，0=免费>>
  * success : Integer
  * error_message : Text
  * created_at : Text
}

space ||--o{ environment : "CASCADE"
space ||--o{ endpoint : "CASCADE"
space ||--o{ test_run : "CASCADE"
space ||--o{ conversation : "CASCADE"
space ||--o{ space_memory : "CASCADE"
space ||--o{ knowledge_document : "CASCADE"
space ||--o{ knowledge_chunk : "CASCADE"
environment ||--o{ test_run : "SET NULL"
environment ||--o{ conversation : "SET NULL"
test_run ||--o{ test_case : "CASCADE"
test_run ||--o{ test_result : "CASCADE"
test_run ||--|| test_summary : "CASCADE (1:1)"
test_run ||--o{ report : "CASCADE"
endpoint ||--o{ test_case : "SET NULL"
test_case ||--o{ test_result : "CASCADE"
conversation ||--o{ message : "CASCADE"
conversation ||--o{ space_memory : "SET NULL"
knowledge_document ||--o{ knowledge_chunk : "CASCADE"

@enduml
