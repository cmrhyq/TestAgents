# LLM配置
llm:
  # 默认模型名（对应 model_list 中的 model_name）
  # 设置为 smart-router 则启用根据任务难度进行路由
  default_model: smart-router

# LiteLLM配置，需要配置多个模型来进行任务复杂度分流
model_list:
  - model_name: glm-4-flash
    litellm_params:
      model: zai/glm-4-flash
      api_key: ""
  - model_name: deepseek-v4-flash
    litellm_params:
      model: deepseek/deepseek-v4-flash
      api_key: ""
  - model_name: deepseek-v4-pro
    litellm_params:
      model: deepseek/deepseek-v4-pro
      api_key: ""
  - model_name: smart-router
    litellm_params:
      model: auto_router/complexity_router
      complexity_router_config:
        tiers:
          SIMPLE: glm-4-flash
          MEDIUM: deepseek-v4-flash
          COMPLEX: deepseek-v4-pro
          REASONING: deepseek-v4-pro
      complexity_router_default_model: glm-4-flash

# 测试执行配置
execution:
  # 超时配置（秒）
  connect_timeout: 5
  read_timeout: 30
  total_timeout: 60

  # 重试配置
  retry:
    max_retries: 2
    retry_interval: 1  # 秒
    retry_on_status: [500, 502, 503, 504]

# 数据库配置
database:
  url: "sqlite:///db/TestAgents.db"
  echo: false
  pool_size: 5
  max_overflow: 10
  pool_timeout: 30
  pool_recycle: 3600

# ChromaDB 向量数据库配置
chroma:
  host: "localhost"
  port: 8000
  auth_provider: "chromadb.auth.token_authn.TokenAuthClientProvider"
  auth_credentials: ""
  auth_token_transport_header: "Authorization"
  tenant: "default_tenant"
  database: "default_database"
  default_collection: "default"

# 日志配置
logging:
  level: INFO  # DEBUG / INFO / WARNING / ERROR
  format: console  # console (彩色开发输出) / json (生产环境JSON输出)

# LangSmith 可观测性配置
langsmith:
  enabled: false  # 设为 true 启用 LangSmith 追踪
  api_key: ""
  project: TestAgents
  endpoint: https://api.smith.langchain.com
